# Copia este archivo a  .env.local  y rellena la clave secreta.
# .env.local NO se sube al repositorio (está en .gitignore).

# --- Supabase ---
# La URL es pública (identifica tu proyecto).
NEXT_PUBLIC_SUPABASE_URL=https://rfivicfvnlkwciyofdnn.supabase.co

# La service_role key es SECRETA. Cópiala de:
#   Supabase → Project Settings → API → Project API keys → service_role
# Solo se usa en el servidor (nunca llega al navegador).
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-tu-service-role-key

# --- Fase 04 (motor del chat: API de Claude) ---
# Consíguela en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=pega-aqui-tu-anthropic-api-key

# --- Fase 09 (panel del asesor) ---
# Contraseña para entrar en /panel. Si no se define, por defecto es "asesor".
ASESOR_PASSWORD=pon-una-contraseña-segura
